const loader = new GLTFLoader();

export class Planet {
    constructor(scene, name, data) {
        this.name = name;
        this.desc = data.desc;
        this.distance = data.distance;
        this.speed = data.speed;
        this.radius = data.radius;
        this.angle = Math.random() * Math.PI * 2;
        
        this.orbitGroup = new THREE.Group();
        scene.add(this.orbitGroup);

        this.mesh = new THREE.Group(); // Container for the planet
        this.mesh.userData.planet = this;
        this.orbitGroup.add(this.mesh);
        this.mesh.position.x = data.distance;

        if (data.model) {
            this.loadModel(data);
        } else if (data.isEarth || data.isMars || data.isTextured) {
            this.planetMesh = this.createPlanetWithShader(data);
            this.mesh.add(this.planetMesh);
        } else {
            const geo = new THREE.SphereGeometry(this.radius, 32, 32);
            const mat = new THREE.MeshStandardMaterial({ color: data.color });
            this.planetMesh = new THREE.Mesh(geo, mat);
            this.mesh.add(this.planetMesh);
        }
    }

    loadModel(data) {
        loader.load(data.model, (gltf) => {
            const model = gltf.scene;
            
            // Center and scale
            const box = new THREE.Box3().setFromObject(model);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());
            model.position.sub(center);
            
            const maxDim = Math.max(size.x, size.y, size.z);
            const scale = (this.radius * 2) / maxDim;
            model.scale.setScalar(scale);

            // Apply shader if textures provided
            if (data.dayTex) {
                const texLoader = new THREE.TextureLoader();
                const dayTex = texLoader.load(data.dayTex);
                const nightTex = data.nightTex ? texLoader.load(data.nightTex) : dayTex;
                
                const material = this.getShaderMaterial(dayTex, nightTex, data.rimColor, !!data.nightTex);
                
                model.traverse(child => {
                    if (child.isMesh) {
                        child.material = material;
                    }
                });
            }

            this.mesh.add(model);
            this.planetMesh = model;
        });
    }

    createPlanetWithShader(data) {
        const texLoader = new THREE.TextureLoader();
        const dayTex = texLoader.load(data.dayTex);
        const nightTex = texLoader.load(data.nightTex || data.dayTex);
        
        const material = this.getShaderMaterial(dayTex, nightTex, data.rimColor, !!data.nightTex);
        return new THREE.Mesh(new THREE.SphereGeometry(this.radius, 64, 64), material);
    }

    getShaderMaterial(dayTex, nightTex, rimColor, hasNightTex) {
        return new THREE.ShaderMaterial({
            uniforms: {
                dayTexture: { value: dayTex },
                nightTexture: { value: nightTex },
                sunDirection: { value: new THREE.Vector3(1, 0, 0) }, // Default non-zero
                rimColor: { value: rimColor || new THREE.Vector3(1, 1, 1) },
                hasNightTexture: { value: hasNightTex ? 1.0 : 0.0 }
            },
            vertexShader: `
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vViewDir;
                void main() {
                    vUv = uv;
                    vec4 worldPos = modelMatrix * vec4(position, 1.0);
                    vNormal = normalize(vec3(modelMatrix * vec4(normal, 0.0)));
                    vViewDir = normalize(cameraPosition - worldPos.xyz);
                    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
                }
            `,
            fragmentShader: `
                uniform sampler2D dayTexture;
                uniform sampler2D nightTexture;
                uniform vec3 sunDirection;
                uniform vec3 rimColor;
                uniform float hasNightTexture;
                varying vec2 vUv;
                varying vec3 vNormal;
                varying vec3 vViewDir;
                void main() {
                    vec3 sDir = normalize(sunDirection);
                    float intensity = dot(normalize(vNormal), sDir);
                    float dayWeight = smoothstep(-0.15, 0.15, intensity);
                    
                    vec3 dayColor = texture2D(dayTexture, vUv).rgb;
                    vec3 nightColor = texture2D(nightTexture, vUv).rgb;
                    
                    if (hasNightTexture < 0.5) {
                        nightColor = dayColor * 0.15; // Slightly brighter night for visibility
                    } else {
                        nightColor *= 2.5; 
                    }
                    
                    vec3 color = mix(nightColor, dayColor, dayWeight);
                    
                    // Atmospheric rim glow
                    float fresnel = pow(1.0 - dot(vNormal, vViewDir), 3.0);
                    color += rimColor * fresnel * 0.6;
                    
                    gl_FragColor = vec4(color, 1.0);
                }
            `
        });
    }
    
    update(stopOrbit = false) {
        if (!stopOrbit) {
            this.angle += this.speed;
            this.orbitGroup.rotation.y = this.angle;
        }
        this.mesh.rotation.y += 0.005;

        // Find the actual mesh/model that has the material
        let target = null;
        if (this.planetMesh) {
            if (this.planetMesh.isMesh) {
                target = this.planetMesh;
            } else {
                this.planetMesh.traverse(child => {
                    if (child.isMesh && child.material && child.material.uniforms) {
                        target = child;
                    }
                });
            }
        }

        if (target && target.material && target.material.uniforms && target.material.uniforms.sunDirection) {
            const worldPos = new THREE.Vector3();
            target.getWorldPosition(worldPos);
            // Sun is at (0,0,0)
            target.material.uniforms.sunDirection.value.copy(worldPos).negate().normalize();
        }
    }
}
