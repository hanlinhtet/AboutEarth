<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>3D Bee Loading Animation - Three.js</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Segoe UI', 'Poppins', 'Arial', sans-serif;
        }
        
        /* Loading overlay - will fade out after animation */
        #loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: #0a0f1e;
            z-index: 100;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none; /* Allow clicking through if needed, but we control fade */
            transition: opacity 1.2s ease-out;
            opacity: 1;
        }
        
        /* Optional text hint */
        .loading-text {
            position: absolute;
            bottom: 30px;
            left: 0;
            right: 0;
            text-align: center;
            color: rgba(255,255,200,0.7);
            font-size: 14px;
            letter-spacing: 2px;
            font-weight: 300;
            z-index: 101;
            font-family: monospace;
        }
        
        /* After fade out, hide overlay completely */
        .hidden-overlay {
            display: none !important;
        }
        
        /* Canvas fills the screen */
        canvas {
            display: block;
            vertical-align: bottom;
        }
        
        /* Instruction / small info (optional) */
        .info {
            position: fixed;
            bottom: 15px;
            right: 15px;
            color: white;
            background: rgba(0,0,0,0.5);
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-family: monospace;
            z-index: 200;
            pointer-events: none;
            backdrop-filter: blur(4px);
        }
    </style>
</head>
<body>
    <div id="loading-overlay">
        <div class="loading-text">🐝 BEE LOADING... 🍯</div>
    </div>
    <div class="info">Three.js | Flying Bee Animation</div>

    <!-- Import Three.js core and add-ons via CDN -->
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.128.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.128.0/examples/jsm/"
            }
        }
    </script>

    <script type="module">
        import * as THREE from 'three';
        import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
        import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';

        // --- Setup Scene, Cameras, Renderers ---
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0a0f1e); // deep night sky / space
        scene.fog = new THREE.FogExp2(0x0a0f1e, 0.008); // subtle fog for depth

        // Perspective Camera: initially we see wide area, bee zooms toward center
        // We'll position camera at (0, 0, 8) looking at origin, but we will move bee dynamically.
        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 1.5, 12);
        camera.lookAt(0, 1, 0);

        // WebGL Renderer
        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true; // soft shadows for depth
        renderer.setPixelRatio(window.devicePixelRatio);
        document.body.appendChild(renderer.domElement);

        // Optional CSS2DRenderer for simple floating label (just for fun, but not needed)
        // We'll keep it simple.

        // --- Lighting to make bee look great ---
        // Ambient light
        const ambientLight = new THREE.AmbientLight(0x404060);
        scene.add(ambientLight);
        
        // Main directional light (sunlight)
        const mainLight = new THREE.DirectionalLight(0xfff5e0, 1.2);
        mainLight.position.set(5, 10, 7);
        mainLight.castShadow = true;
        mainLight.receiveShadow = false;
        mainLight.shadow.mapSize.width = 1024;
        mainLight.shadow.mapSize.height = 1024;
        scene.add(mainLight);
        
        // Fill light from below and back
        const fillLight = new THREE.PointLight(0x4466cc, 0.4);
        fillLight.position.set(0, -2, 2);
        scene.add(fillLight);
        
        // Warm back rim light to highlight edges
        const rimLight = new THREE.PointLight(0xffaa66, 0.6);
        rimLight.position.set(-2, 2, -4);
        scene.add(rimLight);
        
        // Soft fill from front
        const frontFill = new THREE.PointLight(0xffcc88, 0.3);
        frontFill.position.set(0, 1, 3);
        scene.add(frontFill);
        
        // Small point light that follows bee? no, but could add subtlety.
        
        // --- Environment: a few floating particles and a simple ground reference? optional for depth ---
        // Create a subtle grid helper or floating dust particles to emphasize motion
        
        const gridHelper = new THREE.GridHelper(20, 20, 0x88aaff, 0x335588);
        gridHelper.position.y = -1.5;
        gridHelper.material.transparent = true;
        gridHelper.material.opacity = 0.25;
        scene.add(gridHelper);
        
        // Add floating particles (dust motes) to give sense of motion and depth
        const particleCount = 600;
        const particlesGeometry = new THREE.BufferGeometry();
        const particlePositions = new Float32Array(particleCount * 3);
        for (let i = 0; i < particleCount; i++) {
            particlePositions[i*3] = (Math.random() - 0.5) * 40;
            particlePositions[i*3+1] = (Math.random() - 0.5) * 12;
            particlePositions[i*3+2] = (Math.random() - 0.5) * 25 - 15;
        }
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
        const particleMaterial = new THREE.PointsMaterial({ color: 0xaaccff, size: 0.08, transparent: true, opacity: 0.5 });
        const particleSystem = new THREE.Points(particlesGeometry, particleMaterial);
        scene.add(particleSystem);
        
        // --- Create the Bee Group ---
        // We'll build a stylized bee using simple geometries: body (ellipsoid), stripes, head, eyes, wings (translucent)
        const beeGroup = new THREE.Group();
        
        // Body (main abdomen + thorax combined)
        const bodyGeo = new THREE.SphereGeometry(0.55, 32, 32);
        const bodyMat = new THREE.MeshStandardMaterial({ color: 0xffcc44, emissive: 0x442200, roughness: 0.3, metalness: 0.1 });
        const body = new THREE.Mesh(bodyGeo, bodyMat);
        body.scale.set(1.2, 0.85, 1.1);
        body.castShadow = true;
        body.receiveShadow = false;
        beeGroup.add(body);
        
        // Stripes: three dark rings around abdomen
        const stripeMat = new THREE.MeshStandardMaterial({ color: 0x222222, emissive: 0x111111 });
        const stripe1 = new THREE.Mesh(new THREE.TorusGeometry(0.62, 0.08, 24, 48), stripeMat);
        stripe1.rotation.x = Math.PI / 2;
        stripe1.position.z = -0.45;
        stripe1.scale.set(0.9, 0.9, 0.4);
        beeGroup.add(stripe1);
        
        const stripe2 = new THREE.Mesh(new THREE.TorusGeometry(0.62, 0.08, 24, 48), stripeMat);
        stripe2.rotation.x = Math.PI / 2;
        stripe2.position.z = -0.15;
        stripe2.scale.set(0.95, 0.95, 0.4);
        beeGroup.add(stripe2);
        
        const stripe3 = new THREE.Mesh(new THREE.TorusGeometry(0.62, 0.08, 24, 48), stripeMat);
        stripe3.rotation.x = Math.PI / 2;
        stripe3.position.z = 0.15;
        stripe3.scale.set(0.98, 0.98, 0.4);
        beeGroup.add(stripe3);
        
        // Thorax (slightly darker)
        const thoraxGeo = new THREE.SphereGeometry(0.48, 32, 32);
        const thoraxMat = new THREE.MeshStandardMaterial({ color: 0xcc9933, roughness: 0.4 });
        const thorax = new THREE.Mesh(thoraxGeo, thoraxMat);
        thorax.position.z = 0.7;
        thorax.scale.set(0.9, 0.8, 0.7);
        beeGroup.add(thorax);
        
        // Head
        const headGeo = new THREE.SphereGeometry(0.45, 32, 32);
        const headMat = new THREE.MeshStandardMaterial({ color: 0xddbb55 });
        const head = new THREE.Mesh(headGeo, headMat);
        head.position.z = 1.1;
        head.scale.set(0.9, 0.85, 0.7);
        beeGroup.add(head);
        
        // Eyes: large and cute
        const eyeMat = new THREE.MeshStandardMaterial({ color: 0xffffff, emissive: 0x224466 });
        const leftEye = new THREE.Mesh(new THREE.SphereGeometry(0.18, 32, 32), eyeMat);
        leftEye.position.set(-0.32, 0.25, 1.35);
        beeGroup.add(leftEye);
        
        const rightEye = new THREE.Mesh(new THREE.SphereGeometry(0.18, 32, 32), eyeMat);
        rightEye.position.set(0.32, 0.25, 1.35);
        beeGroup.add(rightEye);
        
        // Pupils (black)
        const pupilMat = new THREE.MeshStandardMaterial({ color: 0x000000 });
        const leftPupil = new THREE.Mesh(new THREE.SphereGeometry(0.09, 24, 24), pupilMat);
        leftPupil.position.set(-0.32, 0.22, 1.53);
        beeGroup.add(leftPupil);
        
        const rightPupil = new THREE.Mesh(new THREE.SphereGeometry(0.09, 24, 24), pupilMat);
        rightPupil.position.set(0.32, 0.22, 1.53);
        beeGroup.add(rightPupil);
        
        // Antennae
        const antennaMat = new THREE.MeshStandardMaterial({ color: 0x553322 });
        const antennaLeft = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.35, 6), antennaMat);
        antennaLeft.position.set(-0.22, 0.45, 1.45);
        antennaLeft.rotation.z = -0.4;
        antennaLeft.rotation.x = 0.3;
        beeGroup.add(antennaLeft);
        
        const antennaRight = new THREE.Mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.35, 6), antennaMat);
        antennaRight.position.set(0.22, 0.45, 1.45);
        antennaRight.rotation.z = 0.4;
        antennaRight.rotation.x = 0.3;
        beeGroup.add(antennaRight);
        
        // Wings: translucent, animated later (flapping)
        const wingMat = new THREE.MeshStandardMaterial({ color: 0xccddff, emissive: 0x88aaff, transparent: true, opacity: 0.7, side: THREE.DoubleSide });
        // Left wing
        const leftWing = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.05, 0.45), wingMat);
        leftWing.position.set(-0.7, 0.15, 0.2);
        leftWing.rotation.z = -0.5;
        leftWing.rotation.x = 0.2;
        beeGroup.add(leftWing);
        
        // Right wing
        const rightWing = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.05, 0.45), wingMat);
        rightWing.position.set(0.7, 0.15, 0.2);
        rightWing.rotation.z = 0.5;
        rightWing.rotation.x = 0.2;
        beeGroup.add(rightWing);
        
        // Small extra details: legs (simple lines)
        const legMat = new THREE.MeshStandardMaterial({ color: 0x442200 });
        const legPositions = [
            [-0.4, -0.35, 0.7], [0.4, -0.35, 0.7], 
            [-0.45, -0.4, 0.2], [0.45, -0.4, 0.2],
            [-0.4, -0.4, -0.3], [0.4, -0.4, -0.3]
        ];
        legPositions.forEach(pos => {
            const leg = new THREE.Mesh(new THREE.CylinderGeometry(0.07, 0.07, 0.45, 5), legMat);
            leg.position.set(pos[0], pos[1], pos[2]);
            leg.rotation.x = 0.5;
            leg.rotation.z = pos[0] > 0 ? -0.3 : 0.3;
            beeGroup.add(leg);
        });
        
        // Stinger
        const stinger = new THREE.Mesh(new THREE.ConeGeometry(0.12, 0.35, 8), new THREE.MeshStandardMaterial({ color: 0x663300 }));
        stinger.position.set(0, -0.2, -0.95);
        stinger.rotation.x = 0.2;
        beeGroup.add(stinger);
        
        scene.add(beeGroup);
        
        // Initial position: far right side of screen, and slightly elevated, but also behind camera plane? 
        // We want the bee to fly from the right of the screen (world coordinates X positive, and also Z far away, then move toward center)
        // For dramatic effect: start at (8, 1.2, -5) and then fly towards (0, 1.2, 2) and then zoom in more (closer to camera)
        // But to give "zoom in and coming up to user", we'll move bee from startPos to endPos (center but closer to camera).
        // Meanwhile camera stays fixed at (0,1.5,12). The bee will eventually get very close to camera and fade out overlay.
        
        // Animation state
        let progress = 0; // 0 to 1
        const duration = 4000; // 4 seconds total flight + hover look? Actually we want: fly from right, then hover/look around at center, then zoom in.
        // Let's break into phases: 
        // Phase 0: Fly from right edge (x=7, z=-3) to center region (x=0, z=1) over 1.5 sec.
        // Phase 1: Hover at center, looking around (gentle rotation & slight bobbing) for 1.2 sec.
        // Phase 2: Zoom in towards camera: move from (0,1.2,1) to (0,1.0, 3.5) getting bigger, and then fade out overlay.
        // To make seamless, we'll use a timeline driven by performance or Date.now.
        
        const startPos = new THREE.Vector3(7.5, 1.3, -3.2);
        const midPos = new THREE.Vector3(0, 1.4, 0.8);
        const endPos = new THREE.Vector3(0, 1.0, 4.2); // close to camera at Z=4.2, camera at Z=12, so appears large
        
        let startTime = performance.now();
        let phase = 0; // 0: flying to center, 1: hovering, 2: zooming forward
        let hoverStartTime = 0;
        let zoomStartTime = 0;
        
        // For hover looking around: we'll rotate bee slightly side to side and up/down
        let hoverRotY = 0;
        let hoverRotX = 0;
        let hoverBob = 0;
        
        // Wing flapping animation
        let wingAngle = 0;
        
        // Get overlay element
        const overlay = document.getElementById('loading-overlay');
        
        // Optional: tiny additional glow effect around bee (point light follower)
        const beeGlow = new THREE.PointLight(0xffaa55, 0.8, 8);
        beeGroup.add(beeGlow);
        beeGlow.position.set(0, 0.2, 0);
        
        // Start animation
        function animateBee() {
            const now = performance.now();
            const elapsedTotal = now - startTime;
            
            // Phase management
            if (phase === 0) {
                const phase0Duration = 1600; // fly to center duration ms
                let t = Math.min(1, elapsedTotal / phase0Duration);
                // Ease in-out cubic for smooth landing
                const easeT = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
                // Interpolate position
                const currentPos = new THREE.Vector3().lerpVectors(startPos, midPos, easeT);
                beeGroup.position.copy(currentPos);
                
                // Also add slight rotation while flying: roll to right then level
                const roll = (1 - easeT) * 0.6;
                beeGroup.rotation.z = roll * 0.5;
                beeGroup.rotation.x = -0.1 * easeT;
                beeGroup.rotation.y = (1 - easeT) * 0.8;
                
                if (t >= 1.0) {
                    phase = 1;
                    hoverStartTime = now;
                    beeGroup.position.copy(midPos);
                    // reset rotations for hover
                    beeGroup.rotation.set(0, 0, 0);
                }
            } 
            else if (phase === 1) {
                const hoverDuration = 1300;
                const hoverElapsed = now - hoverStartTime;
                if (hoverElapsed >= hoverDuration) {
                    phase = 2;
                    zoomStartTime = now;
                } else {
                    // Hover behavior: gentle looking around and floating
                    const tHover = hoverElapsed / hoverDuration;
                    // Gentle yaw (looking left/right) and pitch
                    hoverRotY = Math.sin(tHover * Math.PI * 2) * 0.4;
                    hoverRotX = Math.sin(tHover * Math.PI * 1.7) * 0.15;
                    hoverBob = Math.sin(tHover * Math.PI * 3) * 0.05;
                    beeGroup.rotation.y = hoverRotY;
                    beeGroup.rotation.x = hoverRotX;
                    beeGroup.rotation.z = Math.sin(tHover * Math.PI * 2.5) * 0.1;
                    // slight vertical motion
                    beeGroup.position.y = midPos.y + hoverBob * 0.08;
                    // also slight wing flutter while hovering faster
                }
            }
            else if (phase === 2) {
                const zoomDuration = 1400; // zoom in and fade out
                const zoomElapsed = now - zoomStartTime;
                let tZoom = Math.min(1, zoomElapsed / zoomDuration);
                // Ease out cubic for dramatic zoom
                const easeZoom = 1 - Math.pow(1 - tZoom, 3);
                const currentZoomPos = new THREE.Vector3().lerpVectors(midPos, endPos, easeZoom);
                beeGroup.position.copy(currentZoomPos);
                // As bee gets closer, scale up slightly for dramatic effect? Actually perspective handles it, but we can add slight scaling
                const scaleFactor = 1 + easeZoom * 0.25;
                beeGroup.scale.set(scaleFactor, scaleFactor, scaleFactor);
                // rotate forward to look more aggressive / coming to user
                beeGroup.rotation.x = -0.2 * easeZoom;
                beeGroup.rotation.y = Math.sin(tZoom * Math.PI) * 0.2;
                beeGroup.rotation.z = 0;
                
                // Fade out overlay: opacity based on zoom progress
                if (overlay) {
                    const fadeProgress = Math.min(1, easeZoom * 1.2); // start fading earlier
                    overlay.style.opacity = 1 - fadeProgress;
                    if (fadeProgress >= 0.98) {
                        // After fade, we can hide overlay completely and optionally show main app content.
                        // For demo, after full fade we also stop the bee animation but we'll just keep idle.
                        overlay.classList.add('hidden-overlay');
                        // also stop further animation updates? Not necessary, but we can keep bee hovering near camera
                        if (tZoom >= 1.0 && !window._animationFinished) {
                            window._animationFinished = true;
                            // Optionally trigger any app start here, but we just keep bee floating
                            console.log("Loading complete, app ready!");
                        }
                    }
                }
                
                if (tZoom >= 1.0) {
                    // final settle: slight idle hover after zoom, no more phase changes
                    // just keep slight bobbing and wing flapping.
                    if (!window._postZoomIdle) {
                        window._postZoomIdle = true;
                    }
                }
            }
            
            // Wing flapping animation (continuous)
            // faster flap during flight and hover, slower after zoom? always looks lively
            let flapSpeed = 12;
            if (phase === 2) flapSpeed = 16;
            wingAngle += 0.025 * flapSpeed;
            const wingRot = Math.sin(wingAngle) * 0.8;
            if (leftWing && rightWing) {
                leftWing.rotation.z = -0.5 + wingRot * 0.7;
                rightWing.rotation.z = 0.5 - wingRot * 0.7;
            }
            
            // Slight glow intensity pulse
            const intensity = 0.7 + Math.sin(Date.now() * 0.008) * 0.2;
            beeGlow.intensity = intensity;
        }
        
        // Add subtle camera drift or particle movement? particles slowly drift to give motion feeling
        function animateParticles() {
            if (particleSystem) {
                particleSystem.rotation.y += 0.0005;
                particleSystem.rotation.x += 0.0003;
            }
        }
        
        // Rotate rim light for extra flair
        let timeAcc = 0;
        
        // Main render loop
        function render() {
            requestAnimationFrame(render);
            timeAcc += 0.01;
            
            // Update bee animation logic
            animateBee();
            animateParticles();
            
            // Make rim light rotate softly
            rimLight.position.x = -2 + Math.sin(timeAcc * 0.5) * 1;
            rimLight.intensity = 0.6 + Math.sin(timeAcc) * 0.2;
            
            // Update camera slight sway? Not needed, but keep fixed
            camera.lookAt(0, 1.2, 0);
            
            renderer.render(scene, camera);
        }
        
        // Start rendering
        render();
        
        // Handle window resize
        window.addEventListener('resize', onWindowResize, false);
        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }
        
        // Small console info
        console.log('3D Bee Loading Animation Started - Flying from right, hovering, then zooming towards user with fade out');
    </script>
</body>
</html>