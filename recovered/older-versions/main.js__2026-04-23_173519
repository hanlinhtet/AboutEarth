import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { Sun } from './sun.js';
import { planetData, Planet } from './planet.js';

// Setup Scene
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 20, 50);

// Add Starfield
const starGeometry = new THREE.BufferGeometry();
const starMaterial = new THREE.PointsMaterial({ color: 0xffffff });
const starVertices = [];
for (let i = 0; i < 5000; i++) {
    starVertices.push(THREE.MathUtils.randFloatSpread(1000), THREE.MathUtils.randFloatSpread(1000), THREE.MathUtils.randFloatSpread(1000));
}
starGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starVertices, 3));
const stars = new THREE.Points(starGeometry, starMaterial);
scene.add(stars);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);

// Lights
const ambientLight = new THREE.AmbientLight(0x404040);
scene.add(ambientLight);

// Add Sun
const sun = new Sun(scene);

// Add Planets
const planets = Object.keys(planetData).map(name => new Planet(scene, name));

const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();
let focusedPlanet = null;
let isSunFocused = false;

// Track interactivity
window.addEventListener('mousemove', (event) => {
    mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
    mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;
    
    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObjects([...planets.map(p => p.mesh), sun.mesh]);
    
    renderer.domElement.style.cursor = intersects.length > 0 ? 'pointer' : 'crosshair';
});

let targetCameraPos = new THREE.Vector3(0, 20, 50);
let isTransitioning = false;

function onClick(event) {
    raycaster.setFromCamera(mouse, camera);
    const intersects = raycaster.intersectObjects([...planets.map(p => p.mesh), sun.mesh]);
    
    if (intersects.length > 0) {
        planets.forEach(p => p.mesh.scale.set(1, 1, 1));
        sun.mesh.scale.set(1, 1, 1);

        let targetMesh;
        let radius;

        if (intersects[0].object === sun.mesh) {
            focusedPlanet = null;
            isSunFocused = true;
            targetMesh = sun.mesh;
            radius = 5;
            document.getElementById('planet-name').innerText = 'The Sun';
            document.getElementById('planet-desc').innerText = 'The center of our solar system.';
        } else {
            focusedPlanet = planets.find(p => p.mesh === intersects[0].object);
            isSunFocused = false;
            targetMesh = focusedPlanet.mesh;
            radius = planetData[focusedPlanet.name].radius;
            document.getElementById('planet-name').innerText = focusedPlanet.name;
            document.getElementById('planet-desc').innerText = focusedPlanet.desc;
        }

        targetMesh.scale.set(1.5, 1.5, 1.5);

        // Calculate the "Cool" landing spot
        const targetPos = new THREE.Vector3();
        targetMesh.getWorldPosition(targetPos);
        
        const dir = new THREE.Vector3().subVectors(camera.position, targetPos).normalize();
        const idealDistance = radius * 5; 
        
        targetCameraPos.copy(targetPos).add(dir.multiplyScalar(idealDistance));
        isTransitioning = true; // Start the smooth glide
    }
}

window.addEventListener('click', onClick);

document.getElementById('reset-view').addEventListener('click', () => {
    focusedPlanet = null;
    isSunFocused = false;
    planets.forEach(p => p.mesh.scale.set(1, 1, 1));
    sun.mesh.scale.set(1, 1, 1);
    
    // Reset camera to default orbit view
    camera.position.set(0, 20, 50);
    controls.target.set(0, 0, 0);
    
    document.getElementById('planet-name').innerText = 'Solar System';
    document.getElementById('planet-desc').innerText = 'Click a planet to focus.';
});

// Animation Loop
// Animation Loop
function animate() {
    requestAnimationFrame(animate);
    sun.update();
    
    if (!focusedPlanet && !isSunFocused) {
        planets.forEach(p => p.update());
    } else {
        if (focusedPlanet) focusedPlanet.mesh.rotation.y += 0.01;
        if (isSunFocused) sun.mesh.rotation.y += 0.01;
    }
    
    if (focusedPlanet || isSunFocused) {
        const target = focusedPlanet ? focusedPlanet.mesh : sun.mesh;
        const currentTargetPos = new THREE.Vector3();
        target.getWorldPosition(currentTargetPos);
        
        if (isTransitioning) {
            // Cinematic glide to the planet
            controls.target.lerp(currentTargetPos, 0.05);
            camera.position.lerp(targetCameraPos, 0.05);
            
            // If we are very close to the destination, stop transitioning 
            // so the user can take over zoom control
            if (camera.position.distanceTo(targetCameraPos) < 0.1) {
                isTransitioning = false;
            }
        } else {
            // Lock-on mode: Follow the planet's orbit while allowing user zoom
            const offset = new THREE.Vector3().subVectors(camera.position, controls.target);
            controls.target.copy(currentTargetPos);
            camera.position.copy(currentTargetPos).add(offset);
        }
    } else {
        // Smooth return to home view
        const homeTarget = new THREE.Vector3(0, 0, 0);
        const homePos = new THREE.Vector3(0, 20, 50);
        
        controls.target.lerp(homeTarget, 0.05);
        camera.position.lerp(homePos, 0.05);
    }
    
    controls.update();
    renderer.render(scene, camera);
}
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

animate();
