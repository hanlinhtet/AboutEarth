import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

export const planetData = {
    Mercury: { radius: 0.4, distance: 10, color: 0xaaaaaa, speed: 0.04, desc: "Smallest planet.", model: null },
    Venus:   { radius: 0.8, distance: 15, color: 0xe3bb76, speed: 0.03, desc: "Earth's sister.", model: null },
    Earth:   { 
        radius: 0.9, 
        distance: 20, 
        color: 0x2233ff, 
        speed: 0.02, 
        desc: "Our home.", 
        model: 'models/earth_day.glb',
        nightModel: 'models/earth_night.glb'
    },
    Mars:    { radius: 0.7, distance: 25, color: 0xff4422, speed: 0.015, desc: "The Red Planet.", model: null },
    Jupiter: { radius: 2.0, distance: 35, color: 0xd39c7e, speed: 0.01, desc: "Massive gas giant, largest in our system." },
    Saturn:  { radius: 1.7, distance: 45, color: 0xc5ab6e, speed: 0.008, desc: "Famous for its stunning ring system." },
    Uranus:  { radius: 1.2, distance: 55, color: 0xbbe1e4, speed: 0.006, desc: "Ice giant, rotates on its side." },
    Neptune: { radius: 1.1, distance: 65, color: 0x6081ff, speed: 0.005, desc: "Cold, windy, blue ice giant." },
    Pluto:   { radius: 0.2, distance: 75, color: 0x888888, speed: 0.004, desc: "Dwarf planet, located in the Kuiper belt." }
};

const manager = new THREE.LoadingManager();
const loader = new GLTFLoader(manager);

export class Planet {
    constructor(scene, name, data) {
        this.name = name;
        this.desc = data.desc;
        this.distance = data.distance;
        this.speed = data.speed;
        this.radius = data.radius;
        this.angle = Math.random() * Math.PI * 2;
        
        this.sunDirUniform = { value: new THREE.Vector3(1, 0, 0) };

        // 1. Create a placeholder group
        this.mesh = new THREE.Group(); 
        this.mesh.userData.planet = this;
        
        // 2. Add a temporary sphere
        const tempGeo = new THREE.SphereGeometry(data.radius, 32, 32);
        const tempMat = new THREE.MeshStandardMaterial({ color: data.color });
        this.placeholder = new THREE.Mesh(tempGeo, tempMat);
        this.mesh.add(this.placeholder);

        // 3. Load GLBs
        if (data.model) {
            this.loadModel(data.model, true);
        }
        if (data.nightModel) {
            this.loadModel(data.nightModel, false);
        }

        this.orbitGroup = new THREE.Group();
        this.orbitGroup.add(this.mesh);
        scene.add(this.orbitGroup);
        
        this.mesh.position.x = data.distance;
    }

    loadModel(path, isDay) {
        loader.load(path, (gltf) => {
            if (isDay) this.mesh.remove(this.placeholder);
            
            const model = gltf.scene;
            
            // 1. Precise Centering
            // We force the model to be centered so Day and Night models align perfectly
            const box = new THREE.Box3().setFromObject(model);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            
            model.position.sub(center);
            
            // 2. Precise Scaling
            const maxDim = Math.max(size.x, size.y, size.z);
            const scaleFactor = (this.radius * 2) / maxDim;
            
            // Day model is an overlay, Night is the base.
            // We use a tiny offset (0.1%) to prevent Z-fighting.
            model.scale.setScalar(isDay ? scaleFactor * 1.001 : scaleFactor);

            this.applyDayNightShader(model, isDay);
            this.mesh.add(model);

            model.traverse(obj => {
                if (obj.isMesh) {
                    obj.castShadow = true;
                    obj.receiveShadow = true;
                    obj.userData.planet = this; 
                }
            });
        });
    }

    applyDayNightShader(model, isDay) {
        model.traverse(child => {
            if (child.isMesh) {
                // Ensure both materials support transparency
                child.material.transparent = true;
                
                if (isDay) {
                    // Day model is an OVERLAY. 
                    // CRITICAL: depthWrite must be false so it doesn't block the Night model beneath it.
                    child.material.depthWrite = false;
                    child.material.renderOrder = 2; // Render after the night model
                } else {
                    // Night model is the BASE.
                    child.material.depthWrite = true;
                    child.material.renderOrder = 1;
                }
                
                child.material.onBeforeCompile = (shader) => {
                    shader.uniforms.sunDirection = this.sunDirUniform;
                    
                    shader.vertexShader = `
                        varying vec3 vWorldNormal;
                        ${shader.vertexShader}
                    `.replace(
                        `#include <worldpos_vertex>`,
                        `#include <worldpos_vertex>
                         vWorldNormal = normalize( transformDirection( normal, modelMatrix ) );`
                    );

                    shader.fragmentShader = `
                        uniform vec3 sunDirection;
                        varying vec3 vWorldNormal;
                        ${shader.fragmentShader}
                    `.replace(
                        `#include <dithering_fragment>`,
                        `#include <dithering_fragment>
                        float dotNL = dot(vWorldNormal, sunDirection);
                        
                        // Precise 50/50 split centered at 0.0
                        // Day model appears when facing sun (dotNL > 0)
                        // Night model appears when facing away (dotNL < 0)
                        if (dotNL > 0.0) {
                            ${isDay ? `gl_FragColor.a *= smoothstep(0.0, 0.1, dotNL);` : `gl_FragColor.a = 0.0;`}
                        } else {
                            ${isDay ? `gl_FragColor.a = 0.0;` : `gl_FragColor.a *= smoothstep(0.0, -0.1, dotNL);`}
                        }
                        `
                    );
                };
            }
        });
    }
    
    update(stopOrbit = false) {
        if (!stopOrbit) {
            this.angle += this.speed;
            this.orbitGroup.rotation.y = this.angle;
        }
        this.mesh.rotation.y += 0.01;

        // Update sun direction uniform
        // Sun is at (0,0,0), so direction from planet to sun is -planetPosition
        const worldPos = new THREE.Vector3();
        this.mesh.getWorldPosition(worldPos);
        this.sunDirUniform.value.copy(worldPos).negate().normalize();
    }
    }