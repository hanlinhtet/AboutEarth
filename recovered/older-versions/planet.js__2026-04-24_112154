import * as THREE from 'three';
import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

const loader = new GLTFLoader();

export class Planet {
    constructor(scene, name, modelPath, data) {
        this.name = name;
        this.desc = data.desc;
        this.distance = data.distance;
        this.speed = data.speed;
        this.angle = Math.random() * Math.PI * 2;

        this.orbitGroup = new THREE.Group();
        scene.add(this.orbitGroup);

        loader.load(modelPath, (gltf) => {
            this.mesh = gltf.scene;

            // Scale properly (GLB models are often huge or tiny)
            this.mesh.scale.setScalar(data.scale || 1);

            // Enable shadows
            this.mesh.traverse((child) => {
                if (child.isMesh) {
                    child.castShadow = true;
                    child.receiveShadow = true;
                }
            });

            this.orbitGroup.add(this.mesh);
            this.mesh.position.x = this.distance;
        });
    }

    update() {
        this.angle += this.speed;
        this.orbitGroup.rotation.y = this.angle;

        if (this.mesh) {
            this.mesh.rotation.y += 0.005;
        }
    }
}