import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { Sun } from './sun.js';
import { planetData, Planet } from './planet.js';

// Setup Scene
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 20, 50);

// Add Starfield
const starGeometry = new THREE.BufferGeometry();
const starMaterial = new THREE.PointsMaterial({ color: 0xffffff });
const starVertices = [];
for (let i = 0; i < 5000; i++) {
    starVertices.push(THREE.MathUtils.randFloatSpread(1000), THREE.MathUtils.randFloatSpread(1000), THREE.MathUtils.randFloatSpread(1000));
}
starGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starVertices, 3));
const stars = new THREE.Points(starGeometry, starMaterial);
scene.add(stars);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// Setup Controls
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true; // Makes movement feel "weighty" and smooth
controls.dampingFactor = 0.05;
controls.enablePan = true;    // Allows right-click/two-finger drag to move left/right/up/down

// ... (Rest of the file remains same, I will target the animation loop)

function animate() {
    requestAnimationFrame(animate);
    sun.update();
    
    // 1. Handle Planet Orbits
    if (!focusedPlanet && !isSunFocused) {
        planets.forEach(p => p.update());
    } else {
        if (focusedPlanet) focusedPlanet.mesh.rotation.y += 0.01;
        if (isSunFocused) sun.mesh.rotation.y += 0.01;
    }
    
    // 2. Handle Camera Transitions & Following
    if (focusedPlanet || isSunFocused) {
        const target = focusedPlanet ? focusedPlanet.mesh : sun.mesh;
        const currentTargetPos = new THREE.Vector3();
        target.getWorldPosition(currentTargetPos);
        
        if (isTransitioning) {
            // Cinematic glide TO the planet
            controls.target.lerp(currentTargetPos, 0.05);
            camera.position.lerp(targetCameraPos, 0.05);
            
            if (camera.position.distanceTo(targetCameraPos) < 0.1) {
                isTransitioning = false;
            }
        } else {
            // LOCK-ON MODE: Follow the planet as it orbits
            // This moves the center of the orbit (controls.target) to the planet's new position
            const diff = new THREE.Vector3().subVectors(currentTargetPos, controls.target);
            controls.target.add(diff);
            camera.position.add(diff);
        }
    } else {
        // OVERVIEW MODE: 
        // Only lerp if we just clicked 'Reset'. 
        // Once the target is close to center, stop lerping to allow free movement.
        if (controls.target.length() > 0.1) {
            controls.target.lerp(new THREE.Vector3(0, 0, 0), 0.05);
        }
    }
    
    controls.update(); // Required for damping and smooth transitions
    renderer.render(scene, camera);
}
window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

animate();
