const manager = new THREE.LoadingManager();

manager.onStart = (url) => console.log('Started loading:', url);
manager.onLoad = () => console.log('All models loaded! Ready to explore.');
manager.onProgress = (url, itemsLoaded, itemsTotal) => {
    console.log(`Loading file: ${url}. Loaded ${itemsLoaded}/${itemsTotal} files.`);
};

const loader = new GLTFLoader();

export class Planet {
    constructor(scene, name, data) {
        this.name = name;
        this.desc = data.desc;
        this.distance = data.distance;
        this.speed = data.speed;
        this.radius = data.radius;
        this.angle = Math.random() * Math.PI * 2;
        
        // 1. Create a placeholder group
        this.mesh = new THREE.Group(); 
        this.mesh.userData.planet = this;
        
        // 2. Add a temporary sphere so the planet isn't invisible while loading
        const tempGeo = new THREE.SphereGeometry(data.radius, 32, 32);
        const tempMat = new THREE.MeshStandardMaterial({ color: data.color });
        this.placeholder = new THREE.Mesh(tempGeo, tempMat);
        this.mesh.add(this.placeholder);

        // 3. Load GLB if path exists
        if (data.model) {
            loader.load(
                data.model, 
                (gltf) => {
                    console.log(`${this.name} model loaded successfully!`, gltf);
                    this.mesh.remove(this.placeholder);
                    const model = gltf.scene;
                    model.scale.setScalar(data.radius); 
                    this.mesh.add(model);
                },
                (xhr) => {
                    // This logs the percentage progress
                    console.log(`${this.name}: ${(xhr.loaded / xhr.total * 100)}% loaded`);
                },
                (error) => {
                    // This tells you EXACTLY why it failed (usually a 404 Not Found)
                    console.error(`Error loading ${this.name}:`, error);
                }
            );
        }

        this.orbitGroup = new THREE.Group();
        this.orbitGroup.add(this.mesh);
        scene.add(this.orbitGroup);
        
        this.mesh.position.x = data.distance;
    }
    
    update() {
        this.angle += this.speed;
        this.orbitGroup.rotation.y = this.angle;
        this.mesh.rotation.y += 0.01;
    }
}